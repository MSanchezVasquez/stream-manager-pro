{
  "entities": {
    "clients": {
      "title": "Clientes",
      "description": "Clientes de la plataforma de streaming",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "phone": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "status"]
    },
    "client_subscriptions": {
      "title": "Suscripciones de Clientes",
      "description": "Servicios contratados por los clientes con sus credenciales y fechas de corte",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "serviceName": { "type": "string" },
        "hireDate": { "type": "string" },
        "cutDate": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "profileName": { "type": "string" },
        "pin": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "supplierName": { "type": "string" }
      },
      "required": ["clientName", "serviceName", "status"]
    },
    "suppliers": {
      "title": "Proveedores",
      "description": "Proveedores de cuentas y servicios de streaming",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactInfo": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["name"]
    },
    "supplier_accounts": {
      "title": "Cuentas de Proveedores",
      "description": "Cuentas adquiridas a proveedores con sus fechas de vencimiento y navegador",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "serviceName": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "expirationDate": { "type": "string" },
        "browser": { "type": "string" },
        "webmailUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "revision"] },
        "notes": { "type": "string" }
      },
      "required": ["supplierName", "serviceName", "email", "password"]
    },
    "free_profiles": {
      "title": "Perfiles Libres",
      "description": "Perfiles disponibles sin asignar a clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serviceName": { "type": "string" },
        "quantity": { "type": "number" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "browser": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["serviceName", "quantity", "email"]
    },
    "quick_links": {
      "title": "Enlaces Rápidos de Validación",
      "description": "Páginas de códigos y activación",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["title", "url"]
    }
  }
}
